{
  "auto_install_extensions": {
    "material-icon-theme": true,
    "one-dark-pro": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 5000
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 14,
  "completions": {
    "words": "disabled"
  },
  "diff_view_style": "unified",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "icon_theme": "Material Icon Theme",
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."]
    }
  },
  "preferred_line_length": 88,
  "preview_tabs": {
    "enabled": false
  },
  "soft_wrap": "bounded",
  "terminal": {
    "font_family": "MesloLGS NF"
  },
  "theme": {
    "dark": "One Dark Pro",
    "light": "One Light",
  },
  "toolbar": {
    "breadcrumbs": false
  },
  "wrap_guides": [80]
}

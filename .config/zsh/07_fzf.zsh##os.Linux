# Load keybindings and completion synchronously so they are ready in the first
# interactive prompt.
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

# sharkdp/fd for junegunn/fzf
FZF_FD_COMMAND="fdfind --type f --hidden --follow --exclude .git --color=always"
export FZF_CTRL_T_COMMAND="$FZF_FD_COMMAND"
export FZF_DEFAULT_COMMAND="$FZF_FD_COMMAND"
export FZF_DEFAULT_OPTS="--ansi"
